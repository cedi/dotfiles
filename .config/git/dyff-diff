#!/bin/sh
# git external diff driver: semantic dyff for YAML/JSON, plain unified diff
# (rendered by delta) when dyff fails (e.g. helm templates) or sees no change
# (e.g. comment-only edits, which dyff ignores).
# args: path old-file old-hex old-mode new-file new-hex new-mode
out=$(dyff --color on between --omit-header "$2" "$5" 2>/dev/null)
if [ $? -eq 0 ] && [ -n "$(printf %s "$out" | tr -d '[:space:]')" ]; then
  printf '\033[1;34m%s\033[0m\n%s\n\n' "$1" "$out"
else
  diff -u --label "a/$1" --label "b/$1" "$2" "$5"
fi
exit 0
